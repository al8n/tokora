[workspace]

[package]
name = "name-collision-probe"
version = "0.0.0"
edition = "2024"
publish = false

[dependencies]
# `TOKORA_FEATURES` is substituted by run.sh from the INVENTORY's feature point, not written
# here. It used to read `["std", "logos"]` while the inventory was derived at
# `std,logos,trace,rowan`, so any name behind `trace` or `rowan` was simply absent from the
# tokora the probe compiled against — the probe then collided with nothing and the row scored
# UNPROBED, "no collision was constructed", when the truth was "the name was never compiled
# in". A feature point hardcoded here is a silent disagreement with the surface being probed.
tokora = { path = "TOKORA_PATH", default-features = false, features = [TOKORA_FEATURES] }
otherlib = { path = "otherlib" }
# A direct dependency, because the probe is built against BASE as well as head and base has no
# `tokora::rowan` re-export: the typed-CST fixture names `rowan::Language`, `rowan::SyntaxKind` and
# `rowan::SyntaxNode` through it. The requirement matches tokora's own (0.17) so cargo unifies the
# two onto one version — a second rowan would make `SyntaxNode<Lang>` a different type and the
# fixture's `Node` impl would not satisfy tokora's trait at all.
rowan = "0.17"

[features]
inferred = []
turbofish_used = []
turbofish_discarded = []
assoc_path = []
glob_clash = []
